{
  "name": "@esg-hub/mcp-server",
  "version": "1.3.0",
  "description": "MCP server for the ESG Hub knowledge base by Ascent Partners Foundation — search and read ESG, sustainability and climate articles, glossary terms, frameworks and curated resources.",
  "mcpName": "io.github.simonplmak-cloud/esg-hub",
  "type": "module",
  "bin": {
    "esg-hub-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-tools",
    "climate",
    "esg",
    "esg-frameworks",
    "glossary",
    "knowledge-base",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "sustainability"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.15"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonplmak-cloud/esg-hub.git",
    "directory": "mcp-server"
  },
  "homepage": "https://esg-hub.ascent.partners",
  "bugs": {
    "url": "https://github.com/simonplmak-cloud/esg-hub/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
